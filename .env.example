NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=

# Kubera Data API v3 — Settings > API in Kubera. Server-only, never expose to the client.
KUBERA_API_KEY=
KUBERA_API_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# invoking /api/kubera/sync or /api/redbark/sync. Generate with
# `openssl rand -hex 32`. Also set this in Vercel project env vars — Vercel
# adds the header automatically for Cron-triggered requests once it's present.
CRON_SECRET=

# Redbark (api.redbark.com) — bank feed aggregator (NAB/CBA/etc via Open
# Banking/CDR). API key from your Redbark dashboard; REDBARK_API_VERSION is
# the release string Redbark's docs quote, e.g. 2026-10-01.wattle — check
# https://redbark.com/docs/api-reference/v2/overview for the current value.
REDBARK_API_KEY=
REDBARK_API_VERSION=
